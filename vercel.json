{
  "version": 2,
  "projectSettings": {
    "nodeVersion": "20.x"
  },
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "env": {
    "LUXUS_SANITY_PROJECT_ID": {
      "description": "ID del proyecto Sanity",
      "required": true
    },
    "LUXUS_SANITY_DATASET": {
      "description": "Dataset de Sanity (ej: production, staging)",
      "required": true
    },
    "LUXUS_FORMSPREE_ID": {
      "description": "ID del formulario en Formspree",
      "required": true
    },
    "LUXUS_CONTACT_EMAIL_B64": {
      "description": "Email de contacto en base64",
      "required": true
    },
    "LUXUS_GA_ID": {
      "description": "ID de Google Analytics",
      "required": false
    },
    "CORS_ORIGINS": {
      "description": "Orígenes permitidos para CORS (ej: https://luxusconsultores.com,https://www.luxusconsultores.com)",
      "required": false
    },
    "NODE_ENV": {
      "value": "production",
      "required": true
    }
  },
  "framework": "nodejs",
  "regions": [
    "sfo1"
  ],
  "functions": {
    "server.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js",
      "methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH",
        "OPTIONS"
      ]
    },
    {
      "src": "/studio-luxus-blog(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=604800, immutable"
      }
    },
    {
      "src": "/(.*\\.(?:jpg|jpeg|gif|png|webp|ico|svg|woff|woff2|ttf|eot)$)",
      "headers": {
        "cache-control": "public, max-age=604800, immutable"
      }
    },
    {
      "src": "/",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/contacto.html",
      "destination": "/contacto",
      "permanent": true
    },
    {
      "source": "/servicios.html",
      "destination": "/servicios",
      "permanent": true
    },
    {
      "source": "/nosotros.html",
      "destination": "/nosotros",
      "permanent": true
    },
    {
      "source": "/metodologia.html",
      "destination": "/metodologia",
      "permanent": true
    }
  ]
}